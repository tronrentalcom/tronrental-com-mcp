    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": ["dist"]
}
