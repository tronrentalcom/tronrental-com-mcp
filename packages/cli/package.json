{
  "name": "@tronrental-com/cli",
  "version": "1.0.0",
  "description": "tronrental — command line for TronRental: rent TRON energy and bandwidth, check balances and orders",
  "repository": {
    "type": "git",
    "url": "https://github.com/tronrentalcom/tronrental-com-mcp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://tronrental.com/developers",
  "type": "module",
  "bin": {
    "tronrental": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "dev": "tsx src/main.ts"
  },
  "keywords": ["tron", "energy", "bandwidth", "tronrental", "usdt", "cli", "mcp"],
  "author": "TronRental <dev@tronrental.com>",
  "license": "MIT",
